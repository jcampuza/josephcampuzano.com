---
const skeletonRepos = [1, 2, 3];
---

<div aria-busy="true" aria-live="polite">
  <p class="sr-only">Loading GitHub activity</p>

  <div class="mb-8 border-b border-neutral-700 pb-6">
    <p class="mb-3 text-sm uppercase tracking-[0.18em] text-cyan-200">GitHub activity</p>
    <div class="h-5 w-64 animate-pulse bg-neutral-800"></div>
  </div>

  <section>
    <h2 class="mb-4 text-xl font-semibold text-white">Recent repository activity</h2>
    <div class="space-y-3">
      {
        skeletonRepos.map(() => (
          <div class="border border-neutral-700 bg-neutral-900 p-4">
            <div class="flex items-start justify-between gap-4">
              <div class="w-full">
                <div class="h-5 w-40 animate-pulse bg-neutral-800"></div>
                <div class="mt-3 h-4 w-full max-w-[28rem] animate-pulse bg-neutral-800"></div>
              </div>
              <div class="h-6 w-28 shrink-0 animate-pulse bg-neutral-800"></div>
            </div>
            <div class="mt-4 h-3 w-20 animate-pulse bg-neutral-800"></div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <div class="mb-4 flex items-end justify-between gap-4">
      <div>
        <h3 class="text-xl font-semibold text-white">Contribution rhythm</h3>
        <p class="mt-1 text-sm text-neutral-400">Last 18 weeks of public activity</p>
      </div>
      <div class="h-4 w-16 animate-pulse bg-neutral-800"></div>
    </div>
    <div class="h-32 animate-pulse border border-neutral-700 bg-neutral-950"></div>
  </section>
</div>
