---
import { GITHUB_TOKEN } from "astro:env/server";
import Layout from "@/layouts/Layout.astro";
import {
  GITHUB_ACTIVITY_HTTP_CACHE,
  type GitHubActivitySnapshot,
  resolveGitHubActivity,
} from "@/lib/githubActivity";
import { cn } from "@/lib/cn";

export const prerender = false;

let activity: GitHubActivitySnapshot | null = null;
let loadError: string | null = null;

try {
  activity = await resolveGitHubActivity({
    githubToken: GITHUB_TOKEN,
  });
} catch (error) {
  loadError = error instanceof Error ? error.message : "GitHub activity is unavailable.";
}

Astro.response.headers.set("Cache-Control", activity ? GITHUB_ACTIVITY_HTTP_CACHE : "no-store");

const contributionDays = activity?.calendar.flatMap((week) => week.days) ?? [];
const recentDays = contributionDays.slice(-126);
const maxContributionCount = Math.max(...recentDays.map((day) => day.count), 1);

const formatDate = (value: string) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));

const formatDateTime = (value: string) =>
  new Intl.DateTimeFormat("en", {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(new Date(value));

const dayTone = (count: number) => {
  if (count === 0) {
    return "bg-neutral-800 border-neutral-700";
  }

  if (count / maxContributionCount > 0.66) {
    return "bg-emerald-300 border-emerald-200";
  }

  if (count / maxContributionCount > 0.33) {
    return "bg-teal-500 border-teal-300";
  }

  return "bg-cyan-800 border-cyan-600";
};
---

<Layout title="Activity" description="A cached summary of Joseph Campuzano's public GitHub activity.">
  <section class="max-w-[900px]">
    <div class="mb-8 border-b border-neutral-700 pb-6">
      <p class="mb-3 text-sm uppercase tracking-[0.18em] text-cyan-200">GitHub activity</p>
      {
        activity ? (
          <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-300">
            <a
              class="underline decoration-neutral-500 underline-offset-4"
              href={activity.profileUrl}
              target="_blank"
              rel="noreferrer"
            >
              @{activity.username}
            </a>
            <span class="text-neutral-600">/</span>
            <span>
              Updated{" "}
              <time datetime={activity.generatedAt} data-local-time>
                {formatDateTime(activity.generatedAt)}
              </time>
            </span>
            {activity.stale && (
              <>
                <span class="text-neutral-600">/</span>
                <span class="text-amber-200">Serving stale cache while GitHub refreshes</span>
              </>
            )}
          </div>
        ) : (
          <p class="mt-5 max-w-[680px] text-neutral-300">
            The activity snapshot is not available yet. Once the GitHub token is configured, this
            page will fill in automatically.
          </p>
        )
      }
    </div>

    {
      loadError && (
        <div class="mb-8 border border-amber-400/40 bg-amber-950/40 p-4 text-sm text-amber-100">
          {loadError}
        </div>
      )
    }

    {
      activity && (
        <>
          <section>
            <h2 class="mb-4 text-xl font-semibold text-white">Recent repository activity</h2>
            <div class="space-y-3">
              {activity.topRepositories.map((repository) => (
                <a
                  href={repository.url}
                  target="_blank"
                  rel="noreferrer"
                  class="block border border-neutral-700 bg-neutral-900 p-4 transition hover:border-cyan-500/70 hover:no-underline"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="font-medium text-white">{repository.name}</h3>
                      {repository.description && (
                        <p class="mt-2 text-sm leading-6 text-neutral-400">{repository.description}</p>
                      )}
                    </div>
                    {repository.contributionCount !== null && (
                      <span class="shrink-0 border border-neutral-600 px-2 py-1 text-xs text-neutral-300">
                        {repository.contributionCount.toLocaleString()} contributions
                      </span>
                    )}
                  </div>
                  <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-neutral-400">
                    {repository.primaryLanguage && (
                      <span class="inline-flex items-center gap-2">
                        <span
                          class="h-2 w-2 rounded-full"
                          style={`background:${repository.primaryLanguage.color ?? "#67e8f9"}`}
                        />
                        {repository.primaryLanguage.name}
                      </span>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </section>

          <section class="mt-10">
            <div class="mb-4 flex items-end justify-between gap-4">
              <div>
                <h3 class="text-xl font-semibold text-white">Contribution rhythm</h3>
                <p class="mt-1 text-sm text-neutral-400">Last 18 weeks of public activity</p>
              </div>
              <p class="text-sm text-neutral-400">{activity.totals.contributions.toLocaleString()} total</p>
            </div>

            <div class="grid grid-flow-col grid-rows-7 gap-1 overflow-x-auto border border-neutral-700 bg-neutral-950 p-3">
              {recentDays.map((day) => (
                <div
                  class={cn("h-3 w-3 shrink-0 border", dayTone(day.count))}
                  title={`${day.count} contribution${day.count === 1 ? "" : "s"} on ${formatDate(day.date)}`}
                />
              ))}
            </div>
          </section>
        </>
      )
    }
  </section>

  <script>
    const formatLocalTimes = (): void => {
      const formatter = new Intl.DateTimeFormat(undefined, {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
        timeZoneName: "short",
      });

      for (const element of document.querySelectorAll("[data-local-time]")) {
        const value = element.getAttribute("datetime");

        if (!value) {
          continue;
        }

        element.textContent = formatter.format(new Date(value));
      }
    };

    formatLocalTimes();
    document.addEventListener("astro:page-load", formatLocalTimes);
  </script>
</Layout>
