---
import Layout from "@/layouts/Layout.astro";
import GitHubActivity from "@/components/GitHubActivity.astro";
import GitHubActivityFallback from "@/components/GitHubActivityFallback.astro";
---

<Layout
  title="Activity"
  description="A cached summary of Joseph Campuzano's public GitHub activity."
>
  <section class="max-w-[900px]">
    <GitHubActivity server:defer>
      <GitHubActivityFallback slot="fallback" />
    </GitHubActivity>
  </section>
</Layout>
